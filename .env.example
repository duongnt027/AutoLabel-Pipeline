# Copy file này thành .env rồi sửa cho máy của bạn:  cp .env.example .env
# Mọi cấu hình của pipeline nằm ở ĐÂY.
# Thứ tự ưu tiên: biến đặt sẵn ở shell > dòng CUỐI trong file (khai trùng key thì
# dòng cuối thắng, giống shell và python-dotenv).

# ── Môi trường ───────────────────────────────────────────────────────────────
# Mỗi stage sống trong 1 conda env khác nhau (xem docs/SETUP.md):
#   llmdet   : torch 2.2.1 + mmcv 2.2.0 + transformers 4.37.2  (LLMDet, WeDetect)
#   vlx      : torch 2.8   + transformers 5.13                 (SAM3, VLX-Seek)
LLMDET_PYTHON=
VLX_PYTHON=
# WeDetect dùng chung env với LLMDet (bỏ trống = lấy LLMDET_PYTHON)
WEDETECT_PYTHON=

# Thư mục chứa các repo bên thứ ba đã clone (xem docs/SETUP.md)
THIRD_PARTY_DIR=third_party
# Thư mục chứa kết quả mỗi lần chạy
RUNS_ROOT=runs
# Số thread CPU cho MỖI tiến trình con. torch mặc định lấy nửa số core cho mỗi
# tiến trình (56 trên máy 112 core) -> chạy nhiều GPU song song là 100+ thread
# giành nhau CPU mà không nhanh hơn (khâu nặng ở GPU, CPU chỉ decode ảnh).
CPU_THREADS=8

# Token HuggingFace — BẮT BUỘC cho backend s3: facebook/sam3 là gated repo, phải
# accept license ở https://huggingface.co/facebook/sam3 rồi lấy token ở
# https://huggingface.co/settings/tokens
HF_TOKEN=
# ~/.cache/huggingface/modules trên máy dùng chung có thể do root sở hữu ->
# model trust_remote_code sẽ PermissionError. Trỏ sang chỗ mình ghi được:
# HF_MODULES_CACHE=/home/ubuntu/.cache/hf_modules

# ── Bộ nhãn ──────────────────────────────────────────────────────────────────
# Nguồn DUY NHẤT của bộ nhãn: hints (stage 1 vẽ box) + prompts (stage 2 chấm).
AUTOLABEL_CLASSES=classes/classes.json
# TUỲ CHỌN: ép thứ tự class id theo data.yaml có sẵn (để khớp bộ nhãn đang dùng).
# Bỏ trống thì id lấy theo thứ tự khai trong classes.json.
AUTOLABEL_DATA_YAML=

# ── Stage 1 ──────────────────────────────────────────────────────────────────
# Backend mặc định khi không truyền --models: llm / s3 / we (cách nhau dấu phẩy)
AUTOLABEL_MODELS=llm

# LLMDet (Grounding DINO). config + weights ghi TƯƠNG ĐỐI so với LLMDET_REPO:
# config trỏ các model phụ bằng đường dẫn '../huggingface/...'
LLMDET_REPO=third_party/LLMDet
LLMDET_CONFIG=configs/grounding_dino_swin_l.py
LLMDET_WEIGHTS=pretrained_models/large.pth
LLMDET_GPU=0
LLMDET_BATCH=4
# Đo trên 31 ảnh có GT: hạ dưới 0.15 chỉ thêm box nền — 0.07 -> 0.15 bỏ được
# 369/804 FP mà chỉ mất 22/861 TP (recall còn 97,4%), precision 0.52 -> 0.66.
LLMDET_SCORE_THR=0.15
# SAHI (cờ --sahi): cắt ảnh thành ô chồng mép rồi infer từng ô -> bắt vật nhỏ.
# Đo trên 20 ảnh: recall proposal 0.756 -> 0.914, đổi lại chậm ~14 lần.
LLMDET_SAHI_SLICE=1024
LLMDET_SAHI_OVERLAP=0.2

# SAM3 (dùng chung env với VLX-Seek). Đo trên 100 ảnh có GT, ưu tiên coverage vì
# stage 2 lọc precision sau: 0.3 -> 0.05 recall micro 0.908 -> 0.952; xuống tiếp
# 0.02 recall không tăng nữa mà precision giảm -> chọn 0.05.
SAM3_SCORE_THR=0.05

# WeDetect — setup/get_third_party.sh all tải sẵn và in ra đường dẫn checkpoint
WEDETECT_REPO=third_party/WeDetect
WEDETECT_CONFIG=config/wedetect_base.py
WEDETECT_WEIGHTS=third_party/WeDetect/checkpoints/wedetect_base.pth
# Đo trên 100 ảnh có GT: 0.1 -> 0.01 mở lại recall license_plate 0.003 -> 0.169
# và head 0.034 -> 0.264 (ở 0.1 backend gần như liệt 2 lớp này).
WEDETECT_SCORE_THR=0.01
# WeDetect train bằng prompt TIẾNG TRUNG (text encoder XLM-RoBERTa nên hint tiếng
# Anh vẫn chạy được). Muốn chất lượng cao hơn: dịch hints sang tiếng Trung, lưu
# 1 classes.json riêng rồi trỏ vào đây. Bỏ trống = dùng AUTOLABEL_CLASSES.
WEDETECT_CLASSES=

# ── Stage 2 (VLX-Seek) ───────────────────────────────────────────────────────
VLX_CHECKPOINT=omlab/VLX-Seek-1.5-10B
# Đường dẫn repo VLX-Seek (chứa vlx_seek_worker.py)
VLX_REPO=third_party/VLX-Seek
# GPU VẬT LÝ chạy VLX (ghim bằng CUDA_VISIBLE_DEVICES trước khi import torch).
# Khai nhiều GPU thì stage 2 chia ảnh chạy song song, mỗi GPU 1 tiến trình
# (~23GB VRAM mỗi tiến trình) -> nhanh gấp số GPU.  VLX_GPUS=0,1
VLX_GPUS=0
VLX_MAX_NEW_TOKENS=256
# Số box tối đa đưa VLX xem trong 1 lượt gọi: 256 token đầu ra chỉ đủ in ra
# khoảng 40-50 <objN>, quá số này thì câu trả lời bị cắt cụt.
AUTOLABEL_TOPK=40

# ── Ngưỡng quyết định cuối ───────────────────────────────────────────────────
# Giữ box khi VLX chấm >= mức này. Đo trên 250 box GT: >= 0.5 đúng 197/199 (99%)
# nhưng bỏ 20% box; 0.0 = luôn lấy class điểm cao nhất, đúng 235/250 (94%).
# Đổi số này KHÔNG phải chạy lại model: python rebuild_labels.py <run_dir> --min-conf ...
AUTOLABEL_MIN_CONF=0.2
# Bỏ box trùng (IoU) và box nằm lọt trong box khác (IoS = giao / diện tích box nhỏ)
AUTOLABEL_NMS_IOU=0.6
AUTOLABEL_NMS_IOS=0.8
